# Kopieer dit naar .env en vul aan. Alles heeft een werkende default —
# zonder .env draait de backend lokaal, alleen zonder AI-providers/Supabase.

# ---------- AI-providers (minstens één nodig voor uitleg/quiz/flashcards) ----------
# Volgorde/fallback-keten, standaard "gemini,groq,openrouter,mistral,github".
AI_PROVIDER_ORDER=gemini,groq,openrouter,mistral,github

# Gemini (meerdere gratis keys mogen, komma-gescheiden, roteert per model)
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-3-flash-preview,gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# Groq (Llama 4 vision, snel, gratis tier)
GROQ_API_KEYS=

# OpenRouter (gratis vision-modellen van meerdere makers)
OPENROUTER_API_KEYS=

# Mistral La Plateforme (Small 3.1 / Pixtral, gratis tier)
MISTRAL_API_KEYS=

# GitHub Models (gratis met GitHub-account, fine-grained PAT met "Models"-permissie)
GITHUB_MODELS_TOKEN=

# ---------- Publieke omgeving ----------
# Gebruik development lokaal en production bij je host. In production weigert
# de readinesscheck een onveilige of onvolledige basisconfiguratie.
APP_ENV=development
# Definitieve publieke HTTPS-URL, zonder slash aan het einde.
APP_BASE_URL=
# Alleen dit adres kan op een nieuwe productieomgeving eigenaar worden. Laat dit
# in productie nooit leeg; een toevallige eerste bezoeker wordt dan géén owner.
OWNER_EMAIL=

# ---------- Permanente gedeelde cache (optioneel, zie SUPABASE_SETUP.md) ----------
# Zonder deze twee draait alles op lokale schijf — werkt prima, maar overleeft
# geen deploy zonder persistente schijf.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Accountgebonden credits ----------
ENABLE_QUOTA=true
FREE_MONTHLY_CREDITS=200
PREMIUM_MONTHLY_CREDITS=1000
ULTRA_MONTHLY_CREDITS=2000

# ---------- Beveiliging/misbruik ----------
# Frontend en API draaien online op hetzelfde domein. Voeg alleen je echte
# HTTPS-origin toe; gebruik nooit * in productie.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
RATE_LIMIT_MAX_PER_MIN=20
RATE_LIMIT_UPLOAD_MAX_PER_MIN=10
RATE_LIMIT_REGISTER_MAX_PER_HOUR=5
MAX_UPLOAD_MB=80
# Geen AI genereren puur door uploaden en geen quotumvrije publieke prefetch.
PREFETCH_ON_UPLOAD=0
ENABLE_SPECULATIVE_PREFETCH=false

# ---------- Overig ----------
LOG_LEVEL=INFO
BACKEND_CACHE_DIR=backend_cache_v3
# Google Identity Services (OAuth 2.0 Web client-ID, niet een API-key).
# Voeg in Google Cloud Console je frontend toe bij "Authorized JavaScript origins",
# bijvoorbeeld http://localhost:5173 en later https://jouwdomein.nl.
GOOGLE_CLIENT_ID=
# Nieuwe wachtwoordaccounts zijn lokaal handig, maar een publieke site gebruikt
# Google-verificatie om account- en creditmisbruik te voorkomen.
EMAIL_REGISTRATION_ENABLED=false

# ---------- Stripe-abonnementen ----------
# Gebruik eerst uitsluitend sk_test_/whsec_ uit je Stripe-sandbox. Kopieer
# nooit geheime sleutels naar de frontend of de Git-repository.
# Checkout blijft veilig gesloten totdat dit na volledige controle bewust op
# true wordt gezet. Webhooks en het klantenportaal blijven wel bereikbaar.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_ULTRA_PRICE_ID=
# Stripe wordt Merchant of Record en handelt indirecte belasting, fraude en
# chargebacks af. Zet alleen op false als je bewust zelf verkoper blijft.
STRIPE_MANAGED_PAYMENTS=true

# ---------- Wachtwoordherstel via SMTP ----------
# Gebruik bijvoorbeeld Resend, Postmark of de SMTP-server van je mailprovider.
# Zolang SMTP_HOST en SMTP_FROM leeg zijn, verbergt de app de hersteloptie.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Een actief apparaat blijft ingelogd; de sessie wordt halverwege automatisch
# verlengd. Uitloggen of een wachtwoordreset trekt de sessie direct in.
SESSION_DAYS=365
