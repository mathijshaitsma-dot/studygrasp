# Kopieer dit naar .env en vul aan. Alles heeft een werkende default —
# zonder .env draait de backend lokaal, alleen zonder AI-providers/Supabase.

# ---------- AI-providers (minstens één nodig voor uitleg/quiz/flashcards) ----------
# Volgorde/fallback-keten, standaard "gemini,groq,openrouter,mistral,github".
AI_PROVIDER_ORDER=gemini,groq,openrouter,mistral,github

# Gemini (meerdere gratis keys mogen, komma-gescheiden, roteert per model)
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-3-flash-preview,gemini-2.5-flash

# Groq (Llama 4 vision, snel, gratis tier)
GROQ_API_KEYS=

# OpenRouter (gratis vision-modellen van meerdere makers)
OPENROUTER_API_KEYS=

# Mistral La Plateforme (Small 3.1 / Pixtral, gratis tier)
MISTRAL_API_KEYS=

# GitHub Models (gratis met GitHub-account, fine-grained PAT met "Models"-permissie)
GITHUB_MODELS_TOKEN=

# ---------- Permanente gedeelde cache (optioneel, zie SUPABASE_SETUP.md) ----------
# Zonder deze twee draait alles op lokale schijf — werkt prima, maar overleeft
# geen deploy zonder persistente schijf.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Freemium-metering (optioneel, standaard uit) ----------
ENABLE_QUOTA=false
FREE_DAILY_LIMIT=30
PLUS_DAILY_LIMIT=300
PREMIUM_DAILY_LIMIT=0

# ---------- Beveiliging/misbruik ----------
# Zet dit vast op je echte frontend-domein(en) voordat je live gaat, bv.
# CORS_ORIGINS=https://jouwapp.nl (komma-gescheiden voor meerdere).
CORS_ORIGINS=*
RATE_LIMIT_MAX_PER_MIN=20
RATE_LIMIT_UPLOAD_MAX_PER_MIN=10
MAX_UPLOAD_MB=80

# ---------- Overig ----------
LOG_LEVEL=INFO
BACKEND_CACHE_DIR=backend_cache_v3
# Google Identity Services (OAuth 2.0 Web client-ID, niet een API-key).
# Voeg in Google Cloud Console je frontend toe bij "Authorized JavaScript origins",
# bijvoorbeeld http://localhost:5173 en later https://jouwdomein.nl.
GOOGLE_CLIENT_ID=
